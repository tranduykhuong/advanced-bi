# ---------------------------------------------------------------------------
# Environment Configuration — copy this file to .env and fill in values.
# NEVER commit .env to version control.
# ---------------------------------------------------------------------------

# ── PostgreSQL (VPS3) ──────────────────────────────────────────────────────
POSTGRES_DB=bi_dw
POSTGRES_USER=bi_admin
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_PORT=5432

# ── VPS1: Trade Map source PostgreSQL ──────────────────────────────────────
# Landing DB on VPS1 (134.209.99.243). VPS2 ETL reads from here in production.
VPS1_POSTGRES_DB=trademap_db
VPS1_POSTGRES_USER=trademap_admin
VPS1_POSTGRES_PASSWORD=change_me_trademap_password
VPS1_POSTGRES_PORT=5433
# Docker service name on VPS1 / local full stack:
VPS1_DB_HOST=postgres_vps1
# On VPS2 production, set VPS1_DB_HOST to VPS1 public IP (134.209.99.243)

# ── Mock API (VPS1) ────────────────────────────────────────────────────────
MOCK_API_PORT=8000

# ── ETL Engine (VPS2) ─────────────────────────────────────────────────────
# In Docker Compose local dev, DB_HOST resolves to the service name.
# On VPS2 in production, set this to the actual VPS3 IP.
DB_HOST=postgres_dw
DB_PORT=5432
DB_NAME=bi_dw
DB_USER=bi_admin
DB_PASSWORD=change_me_strong_password

# Source API URL — in production, point to VPS1 public IP
VPS1_API_URL=http://mock_api:8000

# Path where raw CSV/Excel files are mounted inside the ETL container
RAW_DATA_PATH=/raw_data

# Rows per chunk for memory-bounded extract/transform/load (lower on small VPS)
ETL_CHUNK_SIZE=10000

# ── General ────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
