<?xml version="1.0" encoding="UTF-8"?>
<!--
  Vietnam_Trade_Analysis_Cube — Mondrian schema for Pentaho Schema Workbench
  Source: dds (Dimensional Data Store), Galaxy Schema.
  Matches cube design in G6_FinalProject_Report_v2.0.docx, Section VI.

  Requires views dds.dim_country_current / dds.dim_product_current
  (SCD2/SCD1 "current row only" filters) — already created on the DB.
-->
<Schema name="TradeAnalytics">

  <Cube name="Vietnam_Trade_Analysis_Cube">
    <Table schema="dds" name="fact_trade_transaction"/>

    <!-- ==================== dim_time ==================== -->
    <Dimension name="dim_time" foreignKey="time_key" type="TimeDimension">
      <Hierarchy hasAll="true" allMemberName="All Time" primaryKey="time_key">
        <Table schema="dds" name="dim_time"/>
        <Level name="year"    column="year"    type="Numeric" uniqueMembers="true"  levelType="TimeYears"/>
        <Level name="quarter" column="quarter" type="Numeric" uniqueMembers="false" levelType="TimeQuarters"/>
        <Level name="month"   column="month"   type="Numeric" uniqueMembers="false" levelType="TimeMonths"/>
      </Hierarchy>
    </Dimension>

    <!-- ==================== dim_product ==================== -->
    <!-- Hierarchy per report VI.1: chapter_name -> heading_name -> product_name -->
    <Dimension name="dim_product" foreignKey="product_key">
      <Hierarchy hasAll="true" allMemberName="All Products" primaryKey="product_key">
        <Table schema="dds" name="dim_product_current"/>
        <Level name="chapter_name" column="hs_chapter"   nameColumn="chapter_name" type="String" uniqueMembers="true"/>
        <Level name="heading_name" column="heading_name" type="String" uniqueMembers="false"/>
        <Level name="product_name" column="hs_code"       nameColumn="product_name" type="String" uniqueMembers="true"/>
      </Hierarchy>
    </Dimension>

    <!-- ==================== dim_country (partner) ==================== -->
    <Dimension name="dim_country" foreignKey="partner_key">
      <Hierarchy hasAll="true" allMemberName="All Countries" primaryKey="country_key">
        <Table schema="dds" name="dim_country_current"/>
        <Level name="continent"    column="continent"    type="String" uniqueMembers="true"/>
        <Level name="region"       column="region"       type="String" uniqueMembers="false"/>
        <Level name="country_name" column="country_name" nameColumn="country_name" ordinalColumn="country_code"
               type="String" uniqueMembers="true"/>
      </Hierarchy>
    </Dimension>

    <!-- ==================== Flow Type (degenerate dimension) ==================== -->
    <!-- flow_type is a BOOLEAN column. Mondrian wraps level predicates in UPPER()
         for case-insensitive matching, and UPPER(boolean) fails on PostgreSQL
         ("function upper(boolean) does not exist") whenever a single flow is
         isolated (Export/Import KPI, TradeSurplus). Casting the key to text via
         KeyExpression makes UPPER() valid while keeping members [true]/[false]. -->
    <Dimension name="Flow Type" foreignKey="flow_type">
      <Hierarchy hasAll="true" allMemberName="All Flows" primaryKey="flow_type">
        <Level name="Flow" type="String" uniqueMembers="true" caption="Export/Import">
          <KeyExpression><SQL dialect="generic">CAST(flow_type AS VARCHAR)</SQL></KeyExpression>
        </Level>
      </Hierarchy>
    </Dimension>

    <!-- ==================== Source System (degenerate dimension) ==================== -->
    <!-- Lets dashboards slice by data source (TRADE_MAP / UN_COMTRADE / NSO) so the
         three overlapping sources are not summed together (avoids double counting). -->
    <Dimension name="Source System" foreignKey="source_system">
      <Hierarchy hasAll="true" allMemberName="All Sources" primaryKey="source_system">
        <Level name="Source" column="source_system" type="String" uniqueMembers="true"/>
      </Hierarchy>
    </Dimension>

    <!-- ==================== Measures ==================== -->
    <Measure name="TradeValue_USD" column="value"    aggregator="sum" formatString="#,###"/>
    <Measure name="TradeValue_VND" column="value_vnd" aggregator="sum" formatString="#,###"/>
    <Measure name="TotalQuantity"  column="quantity" aggregator="sum" formatString="#,###"/>
    <Measure name="Transaction Count" column="trade_key" aggregator="count" formatString="#,###"/>

    <!-- ==================== Calculated Measures ==================== -->
    <!-- TradeSurplus = Export (flow_type=True) - Import (flow_type=False), in VND -->
    <CalculatedMember name="TradeSurplus" dimension="Measures">
      <Formula>
        (([Flow Type].[Flow].[true], [Measures].[TradeValue_VND])
        - ([Flow Type].[Flow].[false], [Measures].[TradeValue_VND]))
      </Formula>
      <CalculatedMemberProperty name="FORMAT_STRING" value="#,###"/>
    </CalculatedMember>

    <!-- AsymmetryRatio = |TradeSurplus| / TradeValue_VND -->
    <CalculatedMember name="AsymmetryRatio" dimension="Measures">
      <Formula>
        Abs([Measures].[TradeSurplus]) / [Measures].[TradeValue_VND]
      </Formula>
      <CalculatedMemberProperty name="FORMAT_STRING" value="0.00%"/>
    </CalculatedMember>

    <!-- GrowthRateMoM = (this month - prior month) / prior month, along dim_time.month -->
    <CalculatedMember name="GrowthRateMoM" dimension="Measures">
      <Formula>
        ([Measures].[TradeValue_VND] - ([dim_time].[month].CurrentMember.PrevMember, [Measures].[TradeValue_VND]))
        / ([dim_time].[month].CurrentMember.PrevMember, [Measures].[TradeValue_VND])
      </Formula>
      <CalculatedMemberProperty name="FORMAT_STRING" value="0.00%"/>
    </CalculatedMember>

    <!-- SharePercent = share of current member's value within its parent level total -->
    <CalculatedMember name="SharePercent" dimension="Measures">
      <Formula>
        [Measures].[TradeValue_VND] / ([dim_product].[chapter_name].CurrentMember.Parent, [Measures].[TradeValue_VND]) * 100
      </Formula>
      <CalculatedMemberProperty name="FORMAT_STRING" value="0.00"/>
    </CalculatedMember>

  </Cube>

  <!-- ==================== FTA Utilization Cube ==================== -->
  <!-- fact_trade_transaction.fta_keys is an INTEGER[] (many-to-many with dim_fta),
       which Mondrian cannot join directly, and Mondrian Virtual Cubes proved too
       fragile (cross-cube divide-by-zero on this build) for computing the ratio
       live. dds.fta_utilization_by_agreement (migration 012) pre-joins at
       (fta_name, time_key) grain — by AGREEMENT, since ~2130 fta_key collapse to
       ~355 agreements — so a dashboard TIME filter applies. UtilizationRate is a
       ratio, so it is computed live as a CalculatedMember: the numerator is the
       current agreement's count and the denominator is the sentinel member
       [dim_fta].[ALL VN TRADE] (fta_name = 'ALL VN TRADE', total VN transactions
       per period). Both share the current dim_time context, so the rate stays
       correct under any time slice; summed over all periods it equals the
       whole-period rate. -->
  <Cube name="FTA_Utilization_Cube">
    <Table schema="dds" name="fta_utilization_by_agreement"/>

    <Dimension name="dim_time" foreignKey="time_key" type="TimeDimension">
      <Hierarchy hasAll="true" allMemberName="All Time" primaryKey="time_key">
        <Table schema="dds" name="dim_time"/>
        <Level name="year"    column="year"    type="Numeric" uniqueMembers="true"  levelType="TimeYears"/>
        <Level name="quarter" column="quarter" type="Numeric" uniqueMembers="false" levelType="TimeQuarters"/>
        <Level name="month"   column="month"   type="Numeric" uniqueMembers="false" levelType="TimeMonths"/>
      </Hierarchy>
    </Dimension>

    <!-- dim_fta: distinct agreement names + sentinel "ALL VN TRADE" (denominator).
         Keyed by fta_name because ~2130 fta_key collapse to ~355 agreements and
         users analyse utilization per agreement, not per granular fta_key. -->
    <Dimension name="dim_fta" foreignKey="fta_name">
      <Hierarchy hasAll="true" allMemberName="All FTAs" primaryKey="fta_name">
        <Table schema="dds" name="dim_fta_agreement"/>
        <Level name="fta_name" column="fta_name" type="String" uniqueMembers="true"/>
      </Hierarchy>
    </Dimension>

    <Measure name="FTA Trade Count" column="fta_trade_count" aggregator="sum" formatString="#,###"/>

    <!-- UtilizationRate = current FTA count / sentinel (total VN) count, in the
         current time context. Percent of VN transactions eligible for this FTA. -->
    <CalculatedMember name="UtilizationRate" dimension="Measures">
      <Formula>
        [Measures].[FTA Trade Count]
        / ([dim_fta].[fta_name].[ALL VN TRADE], [Measures].[FTA Trade Count]) * 100
      </Formula>
      <CalculatedMemberProperty name="FORMAT_STRING" value="0.00"/>
    </CalculatedMember>
  </Cube>

  <!-- ==================== Exchange Rate Cube ==================== -->
  <!-- Backs the USD/VND volatility tile (report problem #6). Grain in
       dds.fact_exchange_rate is daily; measures aggregate to the dim_time
       month for a monthly line, with Max/Min exposing intra-month volatility.
       exchange_rate = VND per USD. -->
  <Cube name="Exchange_Rate_Cube">
    <Table schema="dds" name="fact_exchange_rate"/>

    <Dimension name="dim_time" foreignKey="time_key" type="TimeDimension">
      <Hierarchy hasAll="true" allMemberName="All Time" primaryKey="time_key">
        <Table schema="dds" name="dim_time"/>
        <Level name="year"    column="year"    type="Numeric" uniqueMembers="true"  levelType="TimeYears"/>
        <Level name="quarter" column="quarter" type="Numeric" uniqueMembers="false" levelType="TimeQuarters"/>
        <Level name="month"   column="month"   type="Numeric" uniqueMembers="false" levelType="TimeMonths"/>
      </Hierarchy>
    </Dimension>

    <Measure name="ExchangeRate_Avg" column="exchange_rate" aggregator="avg" formatString="#,###.00"/>
    <Measure name="ExchangeRate_Max" column="exchange_rate" aggregator="max" formatString="#,###.00"/>
    <Measure name="ExchangeRate_Min" column="exchange_rate" aggregator="min" formatString="#,###.00"/>
  </Cube>

  <!-- ==================== Trade Forecast Cube ==================== -->
  <!-- Actual vs Forecast with a confidence band, from dds.v_trade_forecast_detail
       (migration 013). Grain is (time_key, product_key, partner_key, flow_type),
       so the cube exposes full dimensions: time, product (chapter_name ->
       product_key, chapter name sourced from dim_product_current), partner
       (country_name keyed by partner_key, sourced from dim_country_current) and
       flow. The cleaning view enforces the band PER ROW (lower <= forecast <=
       upper, all >= 0); summation preserves that, so the band stays coherent
       when rolled up to any level. prophet_v1 levels are INDICATIVE only (they
       run large and oscillate) — the chart shows trend and uncertainty shape,
       not calibrated magnitudes, until the model is retrained.
       Fan chart: dim_time.month on rows, {Actual, Forecast, Forecast Lower,
       Forecast Upper} as line series; drill by product chapter or partner as
       needed. -->
  <Cube name="Trade_Forecast_Cube">
    <Table schema="dds" name="v_trade_forecast_detail"/>

    <Dimension name="dim_time" foreignKey="time_key" type="TimeDimension">
      <Hierarchy hasAll="true" allMemberName="All Time" primaryKey="time_key">
        <Table schema="dds" name="dim_time"/>
        <Level name="year"    column="year"    type="Numeric" uniqueMembers="true"  levelType="TimeYears"/>
        <Level name="quarter" column="quarter" type="Numeric" uniqueMembers="false" levelType="TimeQuarters"/>
        <Level name="month"   column="month"   type="Numeric" uniqueMembers="false" levelType="TimeMonths"/>
      </Hierarchy>
    </Dimension>

    <!-- dim_product: key + chapter_name. chapter_name comes from
         dim_product_current; drill chapter_name -> product_key. -->
    <Dimension name="dim_product" foreignKey="product_key">
      <Hierarchy hasAll="true" allMemberName="All Products" primaryKey="product_key">
        <Table schema="dds" name="dim_product_current"/>
        <Level name="chapter_name" column="hs_chapter"  nameColumn="chapter_name" type="String"  uniqueMembers="true"/>
        <Level name="product_key"  column="product_key" nameColumn="product_name" type="Integer" uniqueMembers="true"/>
      </Hierarchy>
    </Dimension>

    <!-- dim_partner: key + name. Members are keyed by partner_key
         (= country_key) and display country_name from dim_country_current. -->
    <Dimension name="dim_partner" foreignKey="partner_key">
      <Hierarchy hasAll="true" allMemberName="All Partners" primaryKey="country_key">
        <Table schema="dds" name="dim_country_current"/>
        <Level name="partner_key" column="country_key" nameColumn="country_name" type="Integer" uniqueMembers="true"/>
      </Hierarchy>
    </Dimension>

    <!-- Same degenerate Flow Type as the main cube: CAST keeps Mondrian's
         UPPER() predicate valid on the boolean key. true=Export, false=Import. -->
    <Dimension name="Flow Type" foreignKey="flow_type">
      <Hierarchy hasAll="true" allMemberName="All Flows" primaryKey="flow_type">
        <Level name="Flow" type="String" uniqueMembers="true" caption="Export/Import">
          <KeyExpression><SQL dialect="generic">CAST(flow_type AS VARCHAR)</SQL></KeyExpression>
        </Level>
      </Hierarchy>
    </Dimension>

    <Measure name="Actual"         column="actual_vnd"     aggregator="sum" formatString="#,###"/>
    <Measure name="Forecast"       column="forecast_vnd"   aggregator="sum" formatString="#,###"/>
    <Measure name="Forecast Lower" column="forecast_lower" aggregator="sum" formatString="#,###"/>
    <Measure name="Forecast Upper" column="forecast_upper" aggregator="sum" formatString="#,###"/>
  </Cube>

  <!-- ==================== ODS Ingestion Monitor (operational) ==================== -->
  <!-- Operational cube on the ODS layer (ods.v_ingest_monitor, migration 011).
       Charts pipeline health: records ingested per day/hour by source_system,
       and late-arriving volume (is_late_arriving). All dimensions are
       degenerate (values live in the fact view) per the report design; the
       Late Arriving key is text so Mondrian's UPPER() predicate is valid on
       PostgreSQL (UPPER(boolean) errors when a member is isolated). -->
  <Cube name="ODS_Ingest_Monitor">
    <Table schema="ods" name="v_ingest_monitor"/>

    <Dimension name="Source System" foreignKey="source_system">
      <Hierarchy hasAll="true" allMemberName="All Sources" primaryKey="source_system">
        <Level name="Source" column="source_system" type="String" uniqueMembers="true"/>
      </Hierarchy>
    </Dimension>

    <!-- Ingest Time: drill Date -> Hour, from created_at (ingest_date is a
         sortable YYYY-MM-DD string so the line-chart x-axis orders correctly). -->
    <Dimension name="Ingest Time" foreignKey="ingest_date">
      <Hierarchy hasAll="true" allMemberName="All Times" primaryKey="ingest_date">
        <Level name="Date" column="ingest_date" type="String"  uniqueMembers="true"/>
        <Level name="Hour" column="ingest_hour" type="Numeric" uniqueMembers="false"/>
      </Hierarchy>
    </Dimension>

    <Dimension name="Late Arriving" foreignKey="is_late_arriving">
      <Hierarchy hasAll="true" allMemberName="All" primaryKey="is_late_arriving">
        <Level name="Is Late" column="is_late_arriving" type="String" uniqueMembers="true" caption="Late Arriving"/>
      </Hierarchy>
    </Dimension>

    <Measure name="Ingested Records" column="ods_id" aggregator="count" formatString="#,###"/>
  </Cube>

  <!-- ==================== ODS Watermark (operational) ==================== -->
  <!-- Per-source ETL high-water mark + freshness (ods.v_watermark_monitor,
       migration 011). MaxPeriodYear/Month are the reliable high-water marks;
       HoursSinceUpdate is data freshness (approximate — Mondrian caches, so
       clear the Saiku cache to refresh). Grain is one row per source, so the
       aggregators just surface the single value. -->
  <Cube name="ODS_Watermark">
    <Table schema="ods" name="v_watermark_monitor"/>

    <Dimension name="Source System" foreignKey="source_system">
      <Hierarchy hasAll="true" allMemberName="All Sources" primaryKey="source_system">
        <Level name="Source" column="source_system" type="String" uniqueMembers="true"/>
      </Hierarchy>
    </Dimension>

    <Measure name="MaxPeriodYear"    column="max_period_year"    aggregator="max" formatString="0"/>
    <Measure name="MaxPeriodMonth"   column="max_period_month"   aggregator="max" formatString="0"/>
    <Measure name="HoursSinceUpdate" column="hours_since_update" aggregator="max" formatString="#,##0.0"/>
  </Cube>

</Schema>
