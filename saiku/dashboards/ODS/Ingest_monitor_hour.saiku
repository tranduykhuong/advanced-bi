{"name":"62990292-810f-40cb-b565-fb989f73420b","cube":{"uniqueName":"[unknown_TradeDW].[TradeAnalytics].[TradeAnalytics].[ODS_Ingest_Monitor]","name":"ODS_Ingest_Monitor","connection":"unknown_TradeDW","catalog":"TradeAnalytics","schema":"TradeAnalytics","caption":"ODS_Ingest_Monitor","visible":true,"timeCalcs":[]},"queryType":"OLAP","type":"MDX","queryModel":{"axes":{"FILTER":{"location":"FILTER","mdx":null,"filters":[],"sortOrder":null,"sortEvaluationLiteral":null,"hierarchizeMode":null,"hierarchies":[],"nonEmpty":false},"COLUMNS":{"location":"COLUMNS","mdx":null,"filters":[],"sortOrder":null,"sortEvaluationLiteral":null,"hierarchizeMode":null,"hierarchies":[{"name":"[Source System].[Source System]","caption":"Source System","dimension":"Source System","levels":{"Source":{"name":"Source"}},"cmembers":{}}],"nonEmpty":true},"ROWS":{"location":"ROWS","mdx":null,"filters":[],"sortOrder":null,"sortEvaluationLiteral":null,"hierarchizeMode":null,"hierarchies":[{"name":"[Ingest Time].[Ingest Time]","caption":"Ingest Time","dimension":"Ingest Time","levels":{"Hour":{"name":"Hour"}},"cmembers":{}}],"nonEmpty":true},"PAGES":{"location":"PAGES","mdx":null,"filters":[],"sortOrder":null,"sortEvaluationLiteral":null,"hierarchizeMode":null,"hierarchies":[],"nonEmpty":false}},"visualTotals":false,"visualTotalsPattern":null,"lowestLevelsOnly":false,"details":{"axis":"COLUMNS","location":"BOTTOM","measures":[{"name":"Ingested Records","uniqueName":"[Measures].[Ingested Records]","caption":"Ingested Records","type":"EXACT"}]},"calculatedMeasures":[],"calculatedMembers":[]},"mdx":"SELECT NON EMPTY CrossJoin([Source System].[Source].Members, {[Measures].[Ingested Records]}) ON COLUMNS,\n  NON EMPTY [Ingest Time].[Hour].Members ON ROWS\nFROM [ODS_Ingest_Monitor]"}